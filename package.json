{
  "name": "osmcorrection",
  "version": "1.0.0",
  "private": true,
  "description": "Check and correct OpenStreetMap tag values in the browser.",
  "author": "Andreas Neumann <andr.neumann@googlemail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyper85/osmCorrection.git"
  },
  "type": "module",
  "workspaces": [
    "libs/osmValidation",
    "libs/osmAssist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "smoke:assist": "node scripts/smoke-assist.mjs"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "opening_hours": "^3.15.0",
    "osm-auth": "^3.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
