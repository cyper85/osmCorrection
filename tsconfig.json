{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "osmvalidation": ["./libs/osmValidation/src/index.ts"],
      "osmassist": ["./libs/osmAssist/src/index.ts"],
      "osmassist/claude": ["./libs/osmAssist/src/claude.ts"]
    }
  },
  "include": ["src", "test", "vite.config.ts"]
}
